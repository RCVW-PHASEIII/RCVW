########################################################################################################################
# The RBS Environment for any Docker-based RCVW deployment
########################################################################################################################
#
# Highway-Rail Grade Crossing Intersection Information
#
# RCVW_MAP: The encoded J2735 MAP structure for the intersection.
#           Note that this parameter is required.
RCVW_MAP=
# RCVW_HRI: The identifier for the HRI. Should match the HRI_ID column of a CBS HRI_ACTIVATIONS database table entry.
#           Note that this does NOT (yet) default from the MAP, thus is required. This parameter also is used as the
#           key identifier when RTCM is proxied from the CBS.
RCVW_HRI=
# RCVW_HRI_DESCRIPTION: A quick interseection description to use in the HRI SPaT message.
#                       Note that this does NOT (yet) default from the MAP, thus is required.
RCVW_HRI_DESCRIPTION=
# RCVW_HRI_TRACKED_LANE: The lane identifier in the intersection that denotes the tracked lane signal group.
#                        Note that this is an optional parameter that does NOT (yet) default from the MAP,
#                        but will default to 0 and will only work with a consistently defined MAP.
RCVW_HRI_TRACKED_LANE=
# RCVW_HRI_TRACKED_LANE: The lane identifier in the intersection that denotes the vehicle ingress lane signal group.
#                        Note that this is an optional parameter that does NOT (yet) default from the MAP,
#                        but will default to 1 and will only work with a consistently defined MAP.
RCVW_HRI_VEHICLE_LANE=
#
# RoadSide-Unit (RSU) Radio Information
#
# RCVW_RSU: The IP address of the local RoadSide-Unit (RSU) radio to broadcast J2735 messages from.
#           Note that this is an optional parameter that will default to the hostname "local-rsu"
RCVW_RSU=
# RCVW_RSU_IFM_PORT: The immediate forward port for the local RoadSide-Unit (RSU) radio.
#                    Note that this is an optional parameter that will default to the standard IFM port of 1516
RCVW_RSU_IFM_PORT=
# RCVW_RSU_AUTHPROTO: The authentication protocol for an NTCIP (SNMP v3) connection to the local RoadSide-Unit (RSU) radio.
#                     Note that this is an optional parameter that will default to the standard "SHA" protocol
RCVW_RSU_AUTHPROTO=
# RCVW_RSU_AUTHPASS: The authentication passwod for an NTCIP (SNMP v3) connection to the local RoadSide-Unit (RSU) radio.
#                    Note that this is a required parameter.
RCVW_RSU_AUTHPASS=
# RCVW_RSU_AUTHPROTO: The privacy protocol for an NTCIP (SNMP v3) connection to the local RoadSide-Unit (RSU) radio.
#                     Note that this is an optional parameter that will default to the standard "AES" encryption
RCVW_RSU_PRIVPROTO=
# RCVW_RSU_AUTHPASS: The authentication passwod for an NTCIP (SNMP v3) connection to the local RoadSide-Unit (RSU) radio.
#                    Note that this is a required parameter.
RCVW_RSU_PRIVPASS=
#
# Highway-Rail Grade Crossing Signal Preemption Detection Information
#
# RCVS_IEEE_INPUT: The serial device file to use to read in the IEEE 1570 messages.
#                  Note that this is an optional parameter that forces the RBS to receive the HRI preemption
#                  status from the IEEE 1570 messages transmitted over the RS-232 or RS-485 serial device.
#                  If not set, the system defaults to reading a hard-wired preemption signal from the
#                  local Digital I/O port. The latter currently presumes specific Neousys POC hardware.
RCVW_IEEE_INPUT=
# RCVW_DIO_PIN: The pin from the local Digital I/O port to read for an active-low preemption signal.
#               Note that this is an optional parameter that will default to 0, and if used currently
#               presumes specific Neousys POC hardware.
RCVW_DIO_PIN=
#
# Highway-Rail Grade Crossing Intersection Ground-Based Correction Information for RealTime Kinematics (RTK)
#
# RCVW_GPS: The GPS device file to configure as a local basestation.
#           Note that this is an optional parameter that is only used for a basestation RBS configuration and
#           will default to the gpsd port on localhost.
RCVW_GPSD_SOURCE=
# RCVW_HRI_LAT: The absolute latitude for the intersection.
#               Note that this is used only for a basestation RBS configuration or an NTRIP source, however,
#               for a basestation configuration this must be specified in 10^7 degrees, e.g., 399570248,
#               but otherwise must be in decimal degrees, e.g., 39.9570248
RCVW_HRI_LAT=
# RCVW_HRI_LON: The absolute longitude for the intersection.
#               Note that this is used only for a basestation RBS configuration or an NTRIP source, however,
#               for a basestation configuration this must be specified in 10^7 degrees, e.g., -832478194,
#               but otherwise must be in decimal degrees, e.g., -83.2478194
RCVW_HRI_LON=
# RCVW_HRI_ALT: The absolute altitude for the intersection.
#               Note that this is only used in the basestation RBS configuration and
#               must be in cm above sea level, e.g. 2482
RCVW_HRI_ALT=
# RCVW_NTRIP_SOURCE: The NTRIP caster URL, e.g., my.example.com:2101/mountpoint
#                    Note that this is an optional parameter only used for a NTRIP source.
RCVW_NTRIP_SOURCE=
#
# Other Runtime Configuration Parameters
#
# RCVW_RBS_IMAGE: The location of the RBS Docker image to use.
#                 Note that this is an optional parameter that will default to the local Docker repository
RCVW_RBS_IMAGE=
# RVCW_RBS_VERSION: The version of the RBS Docker image to use.
#                   Note that this is an optional parameter that will default to the current version of the release (4.0.0)
RCVW_RBS_VERSION=
# RCVW_RBS_MAP_DEBUG: The debug level for the MAP plugin.
#                     Note that this is an optional parameter that will default to "DEBUG"
RCVW_RBS_MAP_DEBUG=
# RCVW_RBS_HRI_DEBUG: The debug level for the HRI status plugin.
#                     Note that this is an optional parameter that will default to "DEBUG"
RCVW_RBS_HRI_DEBUG=
# RCVW_RBS_RSUIFM_DEBUG: The debug level for the RSU immediate forward plugin.
#                        Note that this is an optional parameter that will default to "DEBUG"
RCVW_RBS_RSUIFM_DEBUG=
# RCVW_RBS_RTCM_DEBUG: The debug level for the RTCM plugin.
#                      Note that this is an optional parameter that will default to "DEBUG"
RCVW_RBS_RTCM_DEBUG=

########################################################################################################################
# The CBS Environment for any Docker-based RCVW deployment
########################################################################################################################
#
# The Cloud Messaging Service Connection Information
#
# RCVW_CBS_HOST: The hostname for the CBS messaging service, e.g., Azure Service Bus (AMQP).
#                Note that this is an optional parameter that will default to the local AMQP Docker service.
RCVW_CBS_HOST=
# RCVW_CBS_USER: The user or access key name for the CBS messaging service, e.g., Azure Service Bus (AMQP).
#                Note that this is a required parameter.
RCVW_CBS_USER=
# RCVW_CBS_PASS: The password or access key for the CBS messaging service, e.g., Azure Service Bus (AMQP).
#                Note that this is a required parameter/
RCVW_CBS_PASS=
#
# The Cloud Database Storage Connection Information
#
# RCVW_DB_HOST: The hostname for the CBS database storage component, e.g., Azure SQL.
#               Note that this is an optional parameter that will default to the local SQLite database service
RCVW_DB_HOST=
# RCVW_DB_NAME: The name of the database for the CBS database storage component, e.g., Azure SQL.
#               Note that this is an optional parameter that will default to "rcvw-db"
RCVW_DB_NAME=
# RCVW_DB_USER: The user or access key name for the CBS database storage component, e.g., Azure SQL.
#               Note that this is a required parameter.
RCVW_DB_USER=
# RCVW_DB_USER: The password or access key for the CBS database storage component, e.g., Azure SQL.
#               Note that this is a required parameter.
RCVW_DB_PASS=
#
# The Cloud Database API Connection Information
#
# RCVW_CBS_API: The hostname for the CBS API service, e.g., Azure Data API Builder (DAB).
#               Note that this is an optional parameter that will default to the local DAB Docker service.
# RCVW_CBS_API='dab-container-app.redwave-53404dd1.eastus.azurecontainerapps.io'
#
# Other Runtime Configuration Parameters
#
# RCVW_CBS_TARGET: The target CBS implementation for the Docker containers, e.g., Microsoft Azure
#                  Note that this is an optional parameter that will default to "azure"
RCVW_CBS_TARGET=
# RCVW_CBS_API_IMAGE: The location of the CBS API Docker image to use.
#                     Note that this is an optional parameter that will default to the local Docker repository
RCVW_CBS_API_IMAGE=
# RCVW_CBS_API_VERSION: The version of the CBS API Docker image to use.
#                       Note that this is an optional parameter that will default to the current version of the release (4.0.0)
RCVW_CBS_API_VERSION=
# RCVW_CBS_INGEST_IMAGE: The location of the CBS database ingest Docker image to use.
#                        Note that this is an optional parameter that will default to the local Docker repository
RCVW_CBS_INGEST_IMAGE=
# RCVW_CBS_INGEST_VERSION: The version of the CBS database ingest Docker image to use.
#                          Note that this is an optional parameter that will default to the current version of the release (4.0.0)
RCVW_CBS_INGEST_VERSION=
# RCVW_CBS_RTCM_IMAGE: The location of the CBS RTCM proxy Docker image to use.
#                     Note that this is an optional parameter that will default to the local Docker repository
RCVW_CBS_RTCM_IMAGE=
# RCVW_CBS_RTCM_VERSION: The version of the CBS RTCM proxy Docker image to use.
#                        Note that this is an optional parameter that will default to the current version of the release (4.0.0)
RCVW_CBS_RTCM_VERSION=
# RCVW_CBS_EVENTMGR_IMAGE: The location of the CBS event manager Docker image to use.
#                          Note that this is an optional parameter that will default to the local Docker repository
RCVW_CBS_EVENTMGR_IMAGE=
# RCVW_CBS_EVENTMGR_VERSION: The version of the CBS event manager Docker image to use.
#                            Note that this is an optional parameter that will default to the current version of the release (4.0.0)
RCVW_CBS_EVENTMGR_VERSION=

########################################################################################################################
# The VBS Environment for any Docker-based RCVW deployment
########################################################################################################################
#
# Vehicle Configuration Data
#
# RCVW_GPS: The device file for the local GNSS receiver.
#           Note that this is a optional parameter that defauls to /dev/ttyGPS.
#           See https://gist.github.com/edro15/1c6cd63894836ed982a7d88bef26e4af for details on
#           how to configure your udev to link the local GPS device to /dev/ttyGPS.
RCVW_GPS=
# RCVW_VBS_VEHICLE: An identifier for this vehicle to use in the log messages
#                   Note that this is an optional parameter that defaults to 0
RCVW_VBS_VEHICLE=
# RCVW_VBS_ANTENNA_X: The position of the antenna (in meters) from the driver side of the vehicle.
#                     Note that this is a required parameter.
RCVW_VBS_ANTENNA_X=
# RCVW_VBS_ANTENNA_Y: The position of the antenna (in meters) from the front of the vehicle.
#                     Note that this is a required parameter.
RCVW_VBS_ANTENNA_Y=
# RCVW_VBS_ANTENNA_HEIGHT: The position of the antenna (in meters) above the road surface.
#                          Note that this is a required parameter.
RCVW_VBS_ANTENNA_HEIGHT=
# RCVW_VBS_TYPE: The type of vehicle that is being used, either (1) for a car, (2) for a light truck, (3) for a heavy truck
#                This is an optional parameter that will default to (1) for a car.
RCVW_VBS_TYPE=
# RCVW_VBS_LENGTH: The length of vehicle (in meters) that is being used, from front to back.
#                  This is an optional parameter that will default "4.8", however a misrepresented
#                  vehicle length will impact performance of the on-track warnings.
RCVW_VBS_LENGTH=
#
# Other Runtime Configuration Parameters
#
# RCVW_VBS_IMAGE: The location of the VBS Docker image to use.
#                 Note that this is an optional parameter that will default to the local Docker repository
RCVW_VBS_IMAGE=
# RCVW_VBS_VERSION: The version of the VBS Docker image to use.
#                   Note that this is an optional parameter that will default to the current version of the release (4.0.0)
RCVW_VBS_VERSION=
# RCVW_OBU_FWD_PORT: The local port to listen for incoming J2735 messages from the on-board unit (OBU) radio
#                    Note that this is an optional parameter that will default to "26789".
RCVW_OBU_FWD_PORT=

########################################################################################################################
# Calculated Environment Variables for any Docker-based RCVW deployment. DO NOT EDIT
########################################################################################################################
RCVW_CBS="${RCVW_CBS_HOST:+sb://${RCVW_CBS_USER:?Missing CBS message service user}:${RCVW_CBS_PASS:?Missing CBS messaging service key}@${RCVW_CBS_HOST:-cbs-rabbitmq}}"
