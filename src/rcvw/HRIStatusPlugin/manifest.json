{
	"name":"@TMX_PLUGIN_NAME@",
	"description":"Sends HRI Status as SPAT Message",
	"version":"@PROJECT_VERSION@",
	"exe": "bin/@PROJECT_NAME@",
	"channels":[
		{
			"comment": "TMX RBS core connection. Must use unique IDs for Kafka.",
			"context": "kafka://localhost:29092",
			"config": {
				"auto-subscribe": true,
				"write-only": true,
				"topics": "^(J2735|tmx)/",
				"thread-count": 2,
				"thread-assignment": "ShortestQueue"
			}
		}
	],
	"Frequency": 100,
	"RailPinNumber": 0,
	"LaneMap": [
		{ "tracked": true, "signalGroup": 1 },
		{ "vehicle": true, "signalGroup": 2 }
	],
	"IntersectionID": "No HRI identifier for intersection. Auto-detection from MAP not currently supported.",
	"IntersectionName": "RCVW Intersection",
	"AlwaysSend": true,
	"PortName": "",
	"SerialDataTimeout": 1500,
	"loglevel": "DEBUG"
}